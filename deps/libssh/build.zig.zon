.{
    .name = .libssh,
    .version = "0.12.2",
    .fingerprint = 0xda35516053c953ab,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Unmodified upstream release source; this wrapper owns only the Zig
        // build configuration.
        .libssh_upstream = .{
            .url = "https://www.libssh.org/files/0.12/libssh-0.12.2.tar.xz",
            .hash = "N-V-__8AAAzAYACghIN-RNQ_UyWB44qgZhFOWpMU85CwMJBO",
            .lazy = false,
        },
        // No mbedtls dependency here: libssh compiles against the toolchain's
        // mbedtls headers (found via the -Dacton_sysdeps build option) and the
        // mbedtls objects are linked through Acton's base at the final link.
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
