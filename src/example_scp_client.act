"""Example SCP client: copy one file to or from an SSH server.

Build:  acton build
Run:    ./out/bin/example_scp_client [OPTIONS] put HOST USER LOCAL_FILE REMOTE_PATH
        ./out/bin/example_scp_client [OPTIONS] get HOST USER REMOTE_FILE LOCAL_FILE

--help lists the options.

  - With --password, authenticates by password; otherwise the application
    reads the private key file named by --key (default ~/.ssh/id_ed25519)
    and passes its bytes to ssh.PrivateKey.
  - Host key checking here is permissive (accepts any key) so the example
    works against an unknown server. A real client must verify the host key
    against known_hosts or a pinned fingerprint.
  - The transfer runs the server's scp program (`scp -t` / `scp -f`) on an
    exec channel, so the server needs scp.
  - put reads the whole local file into memory and creates the remote file
    with mode 0644. The Client is created with max_write_buffer=0, because
    ScpPut queues the whole file at once. get collects the chunks and writes
    LOCAL_FILE once the whole file has arrived.
  - --remote-md5 runs md5sum on the remote file after the copy and compares
    its digest with the MD5 of the bytes sent or received, without copying
    the file again. The server needs md5sum (GNU coreutils or BusyBox). MD5
    finds a damaged copy, not a deliberately changed one.

Examples:
  ./out/bin/example_scp_client put 127.0.0.1 alice ./notes.txt /tmp/notes.txt
  ./out/bin/example_scp_client --remote-md5 --password routerpw put 192.168.1.1 root ./image.bin /tmp/image.bin
  ./out/bin/example_scp_client --port 2222 --password secret get example.com alice /etc/hostname ./hostname
  ./out/bin/example_scp_client --key ~/.ssh/id_rsa get example.com alice notes.txt ./notes.txt
"""

import std.argparse
import std.crypto.hash.md5
import file
import net
import lib as ssh


def sh_quote(s: str) -> str:
    """s as one word for a POSIX shell."""
    return "'" + s.replace("'", "'\\''") + "'"


def md5_from_output(out: bytes) -> str:
    """The digest at the start of md5sum's output, or "" when there is none.
    GNU md5sum starts the line with a backslash when it escapes the name."""
    b = out[1:] if out.startswith(b"\\") else out
    if len(b) < 32:
        return ""
    for c in b[:32]:
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)):
            return ""
    return b[:32].decode()


def first_line(b: bytes) -> str:
    text = b.decode().strip()
    i = text.find("\n")
    return text if i < 0 else text[:i]


actor main(env):
    var client: ?ssh.Client = None
    var put = True
    var src = ""
    var dst = ""
    var remote_md5 = False
    var parts: list[bytes] = []
    var data = b""

    def finish(code: int):
        c = client
        if c is not None:
            c.close()
        env.exit(code)

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        # WARNING: accepting any host key is insecure. In production, compare
        # info.fingerprint against a known value before accepting.
        print("host key [" + state + "]", info.key_type, info.fingerprint)
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?Exception):
        if err is not None:
            print("connect error:", err)
            finish(1)
            return
        print("connected")
        if put:
            reader = file.ReadFile(file.ReadFileCap(file.FileCap(env.cap)), src)
            data = await async reader.read()
            await async reader.close()
            ssh.ScpPut(c, dst, data, on_put_done, timeout=300.0)
        else:
            ssh.ScpGet(c, src, on_get_data, on_get_done, timeout=300.0)

    def on_close(c: ssh.Client, reason: str):
        pass

    def on_put_done(op: ssh.ScpPut, err: ?str):
        if err is not None:
            print("put failed:", err)
            finish(1)
            return
        print("sent", len(data), "bytes to", dst)
        check_md5(dst)

    def on_get_data(op: ssh.ScpGet, chunk: bytes):
        parts.append(chunk)

    def on_get_done(op: ssh.ScpGet, err: ?str):
        if err is not None:
            print("get failed:", err)
            finish(1)
            return
        data = b"".join(parts)
        wf = file.WriteFile(file.WriteFileCap(file.FileCap(env.cap)), dst)
        await async wf.write(data)
        await async wf.close()
        print("received", len(data), "bytes into", dst)
        check_md5(src)

    def check_md5(remote_path: str):
        """With --remote-md5, run md5sum on remote_path; otherwise exit."""
        c = client
        if remote_md5 and c is not None:
            ssh.RunCommand(c, "md5sum -- " + sh_quote(remote_path), on_md5_done, timeout=300.0)
        else:
            finish(0)

    def on_md5_done(ch: ssh.Channel, code: int, sig: ?str, out: bytes, err: bytes, error: ?str):
        if error is not None:
            print("MD5 check failed:", error)
            finish(1)
        elif sig is not None:
            print("MD5 check failed: md5sum killed by signal", sig)
            finish(1)
        elif code != 0:
            print("MD5 check failed: md5sum exited with " + str(code) + ":", first_line(err))
            finish(1)
        else:
            want = std.crypto.hash.md5.hash(data).hex()
            got = md5_from_output(out)
            if got == "":
                print("MD5 check failed: unexpected md5sum output:", first_line(out))
                finish(1)
            elif got != want:
                print("MD5 mismatch: remote file", got + ", local copy", want)
                finish(1)
            else:
                print("MD5 matches:", got)
                finish(0)

    def cmd_put(args: std.argparse.Args):
        put = True
        src = args.get_str("local_file")
        dst = args.get_str("remote_path")
        connect(args)

    def cmd_get(args: std.argparse.Args):
        put = False
        src = args.get_str("remote_file")
        dst = args.get_str("local_file")
        connect(args)

    def connect(args: std.argparse.Args):
        host = args.get_str("host")
        user = args.get_str("user")
        remote_md5 = args.get_bool("remote-md5")
        password: ?str = None
        private_keys: ?list[ssh.PrivateKey] = None
        if "password" in args.options:
            password = args.get_str("password")
        else:
            key_file: ?str = None
            if "key" in args.options:
                key_file = args.get_str("key")
            else:
                home = env.vars.getenv("HOME")
                if home is not None:
                    key_file = home + "/.ssh/id_ed25519"
            kf = key_file
            if kf is not None:
                reader = file.ReadFile(file.ReadFileCap(file.FileCap(env.cap)), kf)
                key_bytes = await async reader.read()
                await async reader.close()
                private_keys = [ssh.PrivateKey(key_bytes)]

        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(env.cap))),
            host,
            user,
            on_connect,
            on_close,
            on_hostkey,
            password=password,
            private_keys=private_keys,
            port=u16(args.get_int("port")),
            max_write_buffer=0,
        )

    def _parse_args() -> std.argparse.Args:
        p = std.argparse.Parser()
        p.add_option("port", "int", default=22, help="SSH server port (default 22)")
        p.add_option("password", "str", help="Log in with this password")
        p.add_option("key", "str", help="Without --password, log in with this private key file (default ~/.ssh/id_ed25519)")
        p.add_bool("remote-md5", "After the copy, run md5sum on the remote file and compare its digest")
        put_cmd = p.add_cmd("put", "Upload LOCAL_FILE to REMOTE_PATH", cmd_put)
        put_cmd.add_arg("host", "SSH server")
        put_cmd.add_arg("user", "User name")
        put_cmd.add_arg("local_file", "File to upload")
        put_cmd.add_arg("remote_path", "Remote file to create or overwrite")
        get_cmd = p.add_cmd("get", "Download REMOTE_FILE to LOCAL_FILE", cmd_get)
        get_cmd.add_arg("host", "SSH server")
        get_cmd.add_arg("user", "User name")
        get_cmd.add_arg("remote_file", "Remote file to download")
        get_cmd.add_arg("local_file", "File to write")
        return p.parse(env.argv)

    def start():
        try:
            args = _parse_args()
            cmd = args.cmd
            if cmd is not None:
                cmd(args)
            else:
                print("give a command, put or get; --help shows the usage", err=True)
                env.exit(2)
        except std.argparse.PrintUsage as exc:
            print(exc.error_message)
            env.exit(0)
        except std.argparse.ArgumentError as exc:
            print(exc.error_message, err=True)
            env.exit(2)

    def __startup__():
        after 0: start()
