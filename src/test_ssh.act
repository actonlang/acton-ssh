"""Loopback tests for the ssh module.

Each test starts an in-process ssh.Server on an ephemeral port (port=0) and
connects an ssh.Client to it over 127.0.0.1. Ephemeral ports make the tests
safe to run concurrently (acton test stress).
"""

import file
import logging
import net
import lib as ssh
import testing


def _test_version():
    testing.assertEqual("0.12.2/mbedtls/zlib", ssh.version())


TEST_USER = "testuser"
TEST_PASS = "testpass"


actor ExecTester(t: testing.EnvT):
    """Client runs a command via RunCommand; server serves it via on_exec."""
    log = logging.Logger(t.log_handler)

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var client_closed = False
    var server_closed = False
    var run_ok = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if run_ok and client_closed and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for exec test")

    # --- server side
    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        if req.method == "password" and req.user == TEST_USER and req.password == TEST_PASS:
            sess.accept_auth()
        else:
            sess.reject_auth("invalid credentials")

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))

    def on_exec(sess: ssh.ServerSession, ch: ssh.ServerChannel, cmd: str):
        if cmd == "greet":
            ch.accept_request()
            ch.write(b"hello world\n")
            ch.write_stderr(b"some diagnostics\n")
            ch.send_exit_status(0)
            ch.close()
        else:
            ch.accept_request()
            ch.write_stderr(b"unknown command\n")
            ch.send_exit_status(127)
            ch.close()

    # --- client side
    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        ssh.RunCommand(c, "greet", on_run_exit, timeout=10.0)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def on_run_exit(ch: ssh.Channel, code: int, sig: ?str, out: bytes, err_out: bytes, error: ?str):
        if error is not None:
            finish_error("run error: " + error)
            return
        if code != 0:
            finish_error("unexpected exit code: " + str(code))
            return
        if out != b"hello world\n":
            finish_error("unexpected stdout: " + str(out))
            return
        if err_out != b"some diagnostics\n":
            finish_error("unexpected stderr: " + str(err_out))
            return
        run_ok = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        maybe_finish()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
        on_exec,
    )
    after 10.0: on_timeout()


def _test_exec(t: testing.EnvT):
    """Run a command over a loopback SSH connection and check its output."""
    ExecTester(t)


actor SubsystemTester(t: testing.EnvT):
    """Client opens a subsystem channel, exchanges framed messages."""
    log = logging.Logger(t.log_handler)
    END = b"]]>]]>"
    CLIENT_HELLO = b"<hello>client</hello>]]>]]>"
    SERVER_HELLO = b"<hello>server</hello>]]>]]>"

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var server_buf = b""
    var client_buf = b""
    var client_closed = False
    var server_closed = False
    var session_closed = False
    var exchange_ok = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if exchange_ok and client_closed and server_closed and session_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for subsystem test")

    # --- server side
    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_session_close(sess: ssh.ServerSession, reason: str):
        session_closed = True
        maybe_finish()

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        if req.method == "password" and req.user == TEST_USER and req.password == TEST_PASS:
            sess.accept_auth()
        else:
            sess.reject_auth("invalid credentials")

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        if data is not None:
            server_buf += data
            if server_buf.find(END) >= 0:
                ch.write(SERVER_HELLO)

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))

    def on_subsystem(sess: ssh.ServerSession, ch: ssh.ServerChannel, name: str):
        if name == "netconf":
            ch.accept_request()
        else:
            ch.reject_request("unsupported subsystem")

    def on_exec(sess: ssh.ServerSession, ch: ssh.ServerChannel, cmd: str):
        ch.reject_request("exec disabled")

    # --- client side
    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        ssh.Channel(c, ch_open, ch_out, ch_err, ch_exit, ch_close)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def ch_open(ch: ssh.Channel, err: ?str):
        if err is not None:
            finish_error("channel open error: " + err)
            return
        ch.request_subsystem("netconf")
        ch.write(CLIENT_HELLO)

    def ch_out(ch: ssh.Channel, data: ?bytes):
        if data is not None:
            client_buf += data
            if client_buf.find(END) >= 0 and not exchange_ok:
                if client_buf != SERVER_HELLO:
                    finish_error("unexpected server reply: " + str(client_buf))
                    return
                exchange_ok = True
                ch.close()

    def ch_err(ch: ssh.Channel, data: ?bytes):
        pass

    def ch_exit(ch: ssh.Channel, code: int, sig: ?str):
        pass

    def ch_close(ch: ssh.Channel, reason: str):
        if client is not None:
            client.close()
        if server is not None:
            server.close()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
        on_exec,
        on_subsystem,
        on_session_close,
    )
    after 10.0: on_timeout()


def _test_subsystem(t: testing.EnvT):
    """Exchange framed messages over a subsystem channel."""
    SubsystemTester(t)


actor AuthRejectTester(t: testing.EnvT):
    """Client with a wrong password must fail to connect."""
    log = logging.Logger(t.log_handler)

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var got_auth_error = False
    var server_closed = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if got_auth_error and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for auth reject test")

    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        # Always reject
        sess.reject_auth("invalid credentials")

    def on_channel_open(sess: ssh.ServerSession):
        sess.reject_channel("no channels")

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is None:
            finish_error("connect unexpectedly succeeded")
            return
        got_auth_error = True
        if server is not None:
            server.close()
        maybe_finish()

    def on_client_close(c: ssh.Client, reason: str):
        pass

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password="wrongpass",
            port=port,
            auth_timeout=5.0,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
    )
    after 10.0: on_timeout()


def _test_auth_reject(t: testing.EnvT):
    """Wrong credentials must surface as a connect error."""
    AuthRejectTester(t)


actor HostkeyRejectTester(t: testing.EnvT):
    """Client rejecting the host key must fail to connect."""
    log = logging.Logger(t.log_handler)

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var got_reject_error = False
    var server_closed = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if got_reject_error and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for hostkey reject test")

    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        sess.accept_auth()

    def on_channel_open(sess: ssh.ServerSession):
        sess.reject_channel("no channels")

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        if info.fingerprint == "":
            finish_error("empty host key fingerprint")
            return
        c.reject_hostkey("untrusted")

    def on_connect(c: ssh.Client, err: ?str):
        if err is None:
            finish_error("connect unexpectedly succeeded")
            return
        got_reject_error = True
        if server is not None:
            server.close()
        maybe_finish()

    def on_client_close(c: ssh.Client, reason: str):
        pass

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
    )
    after 10.0: on_timeout()


def _test_hostkey_reject(t: testing.EnvT):
    """Rejecting the host key must surface as a connect error."""
    HostkeyRejectTester(t)


actor EchoPayloadTester(t: testing.EnvT):
    """Client streams a large payload through a server-side echo."""
    log = logging.Logger(t.log_handler)

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var payload = b""
    var echoed = b""
    var sent_eof = False
    var client_closed = False
    var server_closed = False
    var echo_ok = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if echo_ok and client_closed and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for echo payload test, echoed " + str(len(echoed)) + " of " + str(len(payload)))

    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        if req.method == "password" and req.user == TEST_USER and req.password == TEST_PASS:
            sess.accept_auth()
        else:
            sess.reject_auth("invalid credentials")

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        if data is not None:
            # Echo straight back
            ch.write(data)
        else:
            # Client sent EOF; finish the response
            ch.send_exit_status(0)
            ch.close()

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))

    def on_exec(sess: ssh.ServerSession, ch: ssh.ServerChannel, cmd: str):
        if cmd == "echo-stream":
            ch.accept_request()
        else:
            ch.reject_request("unknown command")

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        ssh.Channel(c, ch_open, ch_out, ch_err, ch_exit, ch_close)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def ch_open(ch: ssh.Channel, err: ?str):
        if err is not None:
            finish_error("channel open error: " + err)
            return
        ch.request_exec("echo-stream")
        # Stream the payload in chunks
        chunk_size = 32768
        offset = 0
        while offset < len(payload):
            end = offset + chunk_size
            if end > len(payload):
                end = len(payload)
            ch.write(payload[offset:end])
            offset = end
        ch.send_eof()
        sent_eof = True

    def ch_out(ch: ssh.Channel, data: ?bytes):
        if done:
            return
        if data is not None:
            echoed += data
            if len(echoed) == len(payload):
                if echoed != payload:
                    finish_error("payload corrupted in transit")
                    return
                echo_ok = True
                ch.close()
            elif len(echoed) > len(payload):
                finish_error("received more data than sent: " + str(len(echoed)))

    def ch_err(ch: ssh.Channel, data: ?bytes):
        pass

    def ch_exit(ch: ssh.Channel, code: int, sig: ?str):
        pass

    def ch_close(ch: ssh.Channel, reason: str):
        if client is not None:
            client.close()
        if server is not None:
            server.close()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
        )

    # Build a 128 KiB payload with a non-trivial pattern (> 4 SSH windows)
    var pattern = b""
    for i in range(256):
        pattern += bytes([i])
    for i in range(512):
        payload += pattern

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
        on_exec,
    )
    after 10.0: on_timeout()


def _test_echo_payload(t: testing.EnvT):
    """Stream 128 KiB through a server echo and verify integrity.

    Payload size is kept moderate so the test stays well within the test
    timeout under `acton test stress` with many concurrent workers; raw
    throughput is covered by the bench_echo program.
    """
    EchoPayloadTester(t)


actor ConcurrentChannelsTester(t: testing.EnvT):
    """Multiple concurrent exec channels on one client connection."""
    log = logging.Logger(t.log_handler)
    NUM_CHANNELS = 4

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var completed = 0
    var client_closed = False
    var server_closed = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if completed == NUM_CHANNELS and client_closed and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout, completed " + str(completed) + " of " + str(NUM_CHANNELS))

    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        if req.method == "password" and req.user == TEST_USER and req.password == TEST_PASS:
            sess.accept_auth()
        else:
            sess.reject_auth("invalid credentials")

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))

    def on_exec(sess: ssh.ServerSession, ch: ssh.ServerChannel, cmd: str):
        ch.accept_request()
        ch.write(("response to " + cmd).encode())
        ch.send_exit_status(0)
        ch.close()

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        for i in range(NUM_CHANNELS):
            start_run(c, i)

    def start_run(c: ssh.Client, i: int):
        cmd = "cmd-" + str(i)
        def on_run_exit(ch: ssh.Channel, code: int, sig: ?str, out: bytes, err_out: bytes, error: ?str):
            if error is not None:
                finish_error("run " + cmd + " error: " + error)
                return
            if code != 0:
                finish_error("run " + cmd + " exit code: " + str(code))
                return
            expected = ("response to " + cmd).encode()
            if out != expected:
                finish_error("run " + cmd + " unexpected output: " + str(out))
                return
            completed += 1
            if completed == NUM_CHANNELS:
                if client is not None:
                    client.close()
                if server is not None:
                    server.close()
            maybe_finish()
        ssh.RunCommand(c, cmd, on_run_exit, timeout=15.0)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
        on_exec,
    )
    after 10.0: on_timeout()


def _test_concurrent_channels(t: testing.EnvT):
    """Run several exec channels concurrently over one connection."""
    ConcurrentChannelsTester(t)


actor ServerCloseTester(t: testing.EnvT):
    """Server closes while the client has an open, idle channel.

    Exercises server-initiated teardown with live channels: the client must
    see its channel close and then the connection close, without crashing.
    """
    log = logging.Logger(t.log_handler)

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var channel_open = False
    var client_channel_closed = False
    var client_closed = False
    var server_closed = False
    var closed_server = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if client_channel_closed and client_closed and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for server close test")

    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        sess.accept_auth()

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        # Accept a shell-like channel and leave it idle, then tear the server
        # down so the client observes a server-initiated close.
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))
        if not closed_server:
            closed_server = True
            def kill_server():
                if server is not None:
                    server.close()
            after 0.05: kill_server()

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        ssh.Channel(c, ch_open, ch_out, ch_err, ch_exit, ch_close)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def ch_open(ch: ssh.Channel, err: ?str):
        if err is not None:
            # Channel open may fail if the server is already gone; that still
            # exercises teardown. Treat it as channel-closed.
            client_channel_closed = True
            maybe_finish()
            return
        channel_open = True
        ch.request_shell(with_pty=False)

    def ch_out(ch: ssh.Channel, data: ?bytes):
        pass

    def ch_err(ch: ssh.Channel, data: ?bytes):
        pass

    def ch_exit(ch: ssh.Channel, code: int, sig: ?str):
        pass

    def ch_close(ch: ssh.Channel, reason: str):
        client_channel_closed = True
        if client is not None:
            client.close()
        maybe_finish()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
    )
    after 10.0: on_timeout()


def _test_server_close(t: testing.EnvT):
    """Server teardown with a live client channel must close both sides cleanly."""
    ServerCloseTester(t)


actor ConnectRefusedTester(t: testing.EnvT):
    """Connecting to a closed port must surface as a connect error, not a hang."""
    log = logging.Logger(t.log_handler)

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var port: u16 = 0

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        t.error(Exception(msg))

    def on_timeout():
        finish_error("timeout waiting for connect-refused test")

    # Bind a server only to learn a free port, then close it and connect there.
    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        s.close()

    def on_server_close(s: ssh.Server, reason: str):
        # Port is now free; a connect should be refused.
        connect_to_dead_port()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        sess.reject_auth("no")

    def on_channel_open(sess: ssh.ServerSession):
        sess.reject_channel("no")

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if done:
            return
        if err is None:
            finish_error("connect unexpectedly succeeded to a closed port")
            return
        done = True
        t.success()

    def on_client_close(c: ssh.Client, reason: str):
        pass

    def connect_to_dead_port():
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
            connect_timeout=5.0,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
    )
    after 10.0: on_timeout()


def _test_connect_refused(t: testing.EnvT):
    """Connecting to a closed port must report a connect error, not hang."""
    ConnectRefusedTester(t)


# A throwaway ed25519 keypair generated for tests only. The private key is
# written to a temp file for the client; the server authorizes the matching
# public key (authorized_keys "<type> <base64>" form, no comment).
TEST_PRIVKEY = b"-----BEGIN OPENSSH PRIVATE KEY-----\n" + \
    b"b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW\n" + \
    b"QyNTUxOQAAACDfMArbKiftaOI0gU0yPuZ8/SoP+XH3d5oSnvvEAd2WWwAAAJh1hCuTdYQr\n" + \
    b"kwAAAAtzc2gtZWQyNTUxOQAAACDfMArbKiftaOI0gU0yPuZ8/SoP+XH3d5oSnvvEAd2WWw\n" + \
    b"AAAEBQG+87utFFRNOfpSlapq6mSXYa+P9dTK+uLmNo1L6k2t8wCtsqJ+1o4jSBTTI+5nz9\n" + \
    b"Kg/5cfd3mhKe+8QB3ZZbAAAADmFjdG9uLXNzaC10ZXN0AQIDBAUGBw==\n" + \
    b"-----END OPENSSH PRIVATE KEY-----\n"
TEST_PUBKEY = b"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN8wCtsqJ+1o4jSBTTI+5nz9Kg/5cfd3mhKe+8QB3ZZb"


actor PubkeyAuthTester(t: testing.EnvT):
    """Client authenticates with a private key; server authorizes the pubkey.

    Exercises the server-side publickey two-step probe/sign protocol: on_auth
    must fire exactly once (on the verified signature) with method "publickey"
    and the presented key in authorized_keys form.
    """
    log = logging.Logger(t.log_handler)
    fs = file.FS(file.FileCap(t.env.cap))

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var keypath = ""
    var auth_calls = 0
    var pubkey_seen = False
    var run_ok = False
    var client_closed = False
    var server_closed = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if run_ok and pubkey_seen and client_closed and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for pubkey auth test (auth_calls=" + str(auth_calls) + ")")

    # --- server side
    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        auth_calls += 1
        if req.method != "publickey":
            sess.reject_auth("password not allowed")
            return
        pk = req.pubkey
        if pk is not None and pk == TEST_PUBKEY and req.user == TEST_USER:
            pubkey_seen = True
            sess.accept_auth()
        else:
            sess.reject_auth("unauthorized key")

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))

    def on_exec(sess: ssh.ServerSession, ch: ssh.ServerChannel, cmd: str):
        ch.accept_request()
        ch.write(b"pk-ok\n")
        ch.send_exit_status(0)
        ch.close()

    # --- client side
    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        ssh.RunCommand(c, "go", on_run_exit, timeout=10.0)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def on_run_exit(ch: ssh.Channel, code: int, sig: ?str, out: bytes, err_out: bytes, error: ?str):
        if error is not None:
            finish_error("run error: " + error)
            return
        if out != b"pk-ok\n":
            finish_error("unexpected stdout: " + str(out))
            return
        run_ok = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        maybe_finish()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            private_key_file=keypath,
            port=port,
        )

    def start_server():
        server = ssh.Server(
            net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            u16(0),
            on_listen,
            on_server_close,
            on_session,
            on_auth,
            on_channel_open,
            on_exec,
        )

    def setup():
        dir = await async fs.mktmpdir("acton-ssh-pktest")
        keypath = dir + "/id_ed25519"
        wf = file.WriteFile(file.WriteFileCap(file.FileCap(t.env.cap)), keypath)
        await async wf.write(TEST_PRIVKEY)
        await async wf.close()
        start_server()

    after 0: setup()
    after 10.0: on_timeout()


def _test_pubkey_auth(t: testing.EnvT):
    """Server-side publickey auth: client key, server authorizes pubkey."""
    PubkeyAuthTester(t)


actor WriteBufferLimitTester(t: testing.EnvT):
    """A channel write that would exceed max_write_buffer fails the channel.

    The per-channel cap bounds total buffered-unsent bytes. A single write
    larger than the cap trips it immediately (and the same check bounds
    accumulation from a stalled peer), failing the channel with a buffer-limit
    reason rather than buffering without bound.
    """
    log = logging.Logger(t.log_handler)
    LIMIT = 4096

    var done = False
    var server: ?ssh.Server = None
    var client: ?ssh.Client = None
    var limit_hit = False
    var client_closed = False
    var server_closed = False

    def finish_error(msg: str):
        if done:
            return
        done = True
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        t.error(Exception(msg))

    def maybe_finish():
        if done:
            return
        if limit_hit and client_closed and server_closed:
            done = True
            t.success()

    def on_timeout():
        finish_error("timeout waiting for write buffer limit test")

    def on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            finish_error("server listen error: " + err)
            return
        port = await async s.bound_port()
        start_client(port)

    def on_server_close(s: ssh.Server, reason: str):
        server_closed = True
        maybe_finish()

    def on_session(sess: ssh.ServerSession):
        pass

    def on_auth(sess: ssh.ServerSession, req: ssh.AuthRequest):
        if req.method == "password" and req.user == TEST_USER and req.password == TEST_PASS:
            sess.accept_auth()
        else:
            sess.reject_auth("invalid credentials")

    def srv_on_data(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_stderr(ch: ssh.ServerChannel, data: ?bytes):
        pass

    def srv_on_close(ch: ssh.ServerChannel, reason: str):
        pass

    def on_channel_open(sess: ssh.ServerSession):
        sess.accept_channel(ssh.ServerChannel(sess, srv_on_data, srv_on_stderr, srv_on_close))

    def on_exec(sess: ssh.ServerSession, ch: ssh.ServerChannel, cmd: str):
        ch.accept_request()

    def on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        c.accept_hostkey()

    def on_connect(c: ssh.Client, err: ?str):
        if err is not None:
            finish_error("client connect error: " + err)
            return
        ssh.Channel(c, ch_open, ch_out, ch_err, ch_exit, ch_close)

    def on_client_close(c: ssh.Client, reason: str):
        client_closed = True
        maybe_finish()

    def ch_open(ch: ssh.Channel, err: ?str):
        if err is not None:
            finish_error("channel open error: " + err)
            return
        ch.request_exec("sink")
        # One write larger than the cap must fail the channel.
        ch.write(b"x" * (LIMIT * 4))

    def ch_out(ch: ssh.Channel, data: ?bytes):
        pass

    def ch_err(ch: ssh.Channel, data: ?bytes):
        pass

    def ch_exit(ch: ssh.Channel, code: int, sig: ?str):
        pass

    def ch_close(ch: ssh.Channel, reason: str):
        if reason.find("buffer limit") >= 0:
            limit_hit = True
        else:
            finish_error("channel closed with unexpected reason: " + reason)
            return
        if client is not None:
            client.close()
        if server is not None:
            server.close()
        maybe_finish()

    def start_client(port: u16):
        client = ssh.Client(
            net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
            "127.0.0.1",
            TEST_USER,
            on_connect,
            on_client_close,
            on_hostkey,
            password=TEST_PASS,
            port=port,
            max_write_buffer=LIMIT,
        )

    server = ssh.Server(
        net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
        "127.0.0.1",
        u16(0),
        on_listen,
        on_server_close,
        on_session,
        on_auth,
        on_channel_open,
        on_exec,
    )
    after 10.0: on_timeout()


def _test_write_buffer_limit(t: testing.EnvT):
    """A write exceeding max_write_buffer fails the channel."""
    WriteBufferLimitTester(t)
